{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [{
      "label": "main", "create": false, "title": "Carbon",
      "width": 1320, "height": 840, "minWidth": 980, "minHeight": 640,
      "center": true, "visible": false, "decorations": false, "theme": "Dark", "dragDropEnabled": false
    }]
  },
  "bundle": {
    "targets": ["appimage", "deb", "rpm"],
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": { "recommends": ["libnotify-bin", "gnome-keyring", "fontconfig", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"] },
      "rpm": { "recommends": ["libnotify", "gnome-keyring", "fontconfig", "gstreamer1-plugins-good"] }
    }
  }
}
