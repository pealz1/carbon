{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popouts",
  "description": "The mini player and lyrics windows: follow the main window's events, move and close themselves",
  "windows": ["mini", "lyrics"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-is-minimized",
    "core:window:allow-is-visible"
  ]
}
